{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Node.js 测试用：把客户端 TS 代码 + tools/ TS 编译成 CommonJS 给 sim*.ts 跑。",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "../build-tools",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "cc": ["../tools/mock/cc.ts"],
      "@rtd/shared": ["../shared/dist/cjs/index.js"],
      "@rtd/shared/*": ["../shared/dist/cjs/*"]
    }
  },
  "include": [
    "assets/scripts/**/*.ts",
    "../tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "library",
    "temp",
    "build",
    "settings"
  ]
}
