# ========== 服务端环境变量样例 ==========
# 拷贝为 .env 后按需修改；本服务支持"零依赖运行"，下面任何变量不设置都走内存实现。

# 服务端口
PORT=8765

# Prometheus 指标端口（0 = 关闭）
METRICS_PORT=0

# WebSocket 实现：'uws'（推荐生产） | 'ws'（开发/调试）
WS_IMPL=ws

# MongoDB；不设置则走内存
MONGO_URL=
MONGO_DB=rtd

# Redis；不设置则走内存
REDIS_URL=

# 微信小程序配置（不填则 wx.login 走 mock，msgSecCheck 走本地兜底）
WX_APP_ID=
WX_APP_SECRET=

# 日志等级：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# JWT 密钥（玩家会话）— 生产必须用强随机
JWT_SECRET=replace_me_in_prod_with_random_string

# 同步保护
MAX_ROOMS=2000
MAX_PLAYERS_PER_ROOM=4
STATE_HASH_INTERVAL_WAVES=3
